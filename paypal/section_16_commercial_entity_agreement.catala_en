scope CEAWorldpayRelationship =
  output noPartnershipOrAgency : Boolean
  output independentContractors : Boolean
  output neitherMayBindOther : Boolean

  definition noPartnershipOrAgency equals true
  definition independentContractors equals true
  definition neitherMayBindOther equals true

