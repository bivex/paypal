  output noLiabilityForConsequentialDamages : Boolean
  output noLiabilityForDelaysOutsideControl : Boolean
  output cumulativeLiabilityCappedAtTransactionVolume : Boolean
  output deathAndPersonalInjuryNotExcluded : Boolean
  output fraudLiabilityNotExcluded : Boolean

