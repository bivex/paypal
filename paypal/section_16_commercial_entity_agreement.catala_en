scope CEAWorldpayWarrantyDisclaimer =
  output disclaimAllRepresentationsOrWarranties : Boolean
  output noWarrantyOfMerchantability : Boolean
  output noWarrantyOfFitnessForPurpose : Boolean

  definition disclaimAllRepresentationsOrWarranties equals true
  definition noWarrantyOfMerchantability equals true
  definition noWarrantyOfFitnessForPurpose equals true

