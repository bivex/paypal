  -- Module1ControllerToController
  -- Module2ControllerToProcessor
  -- Module3ProcessorToProcessor
  -- Module4ProcessorToController

declaration enumeration DataProtectionRole =
  -- Controller
  -- Processor

declaration enumeration SCCGoverningLawOption =
