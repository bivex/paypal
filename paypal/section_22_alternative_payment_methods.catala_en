# --- Section 3: Accepting These Terms ---

scope APTAcceptingTerms =
  output acceptedByIntegrationOrInvoice : Boolean
  output integratorMustHavePermissionToBind : Boolean
  output boundEntityIsTheAccountHolder : Boolean
  output feesPerMerchantFeesPage : Boolean

  definition acceptedByIntegrationOrInvoice equals true
  definition integratorMustHavePermissionToBind equals true
  definition boundEntityIsTheAccountHolder equals true
  definition feesPerMerchantFeesPage equals true

# --- Section 4: Using APM Functionality ---

scope APMUsageRules =
  input accountType : AccountType
  input currencyMatchRequired : Boolean
  output payPalMayAllowAPMPayment : Boolean
  output notObligedToAllowAPMPayment : Boolean
  output mustComplyWithAnnex1Provisions : Boolean
  output mayNotProactivelyRefundAPM : Boolean
  output refundOnlyIfStatedInAnnex1 : Boolean
  output mayNotReceiveInOtherCurrencies : Boolean
  output businessAccountRequired : Boolean
  output personalAccountInvoiceOnly : Boolean

  definition payPalMayAllowAPMPayment equals true
  definition notObligedToAllowAPMPayment equals true
  definition mustComplyWithAnnex1Provisions equals true
  definition mayNotProactivelyRefundAPM equals true
  definition refundOnlyIfStatedInAnnex1 equals true
  definition mayNotReceiveInOtherCurrencies equals true
  definition businessAccountRequired equals
    accountType equals AccountType.Business
  definition personalAccountInvoiceOnly equals
    accountType equals AccountType.Personal

# --- Section 5: Your Liability to Us ---

scope APMLiability =
  output apmProvidersTreatedAsAcquirers : Boolean
  output apmPaymentsAtRiskOfReversal : Boolean
  output reversalLiabilitySameAsUserAgreement : Boolean
  output sellerProtectionDoesNotApply : Boolean
  output liabilitySurvivesTermination : Boolean

  definition apmProvidersTreatedAsAcquirers equals true
  definition apmPaymentsAtRiskOfReversal equals true
  definition reversalLiabilitySameAsUserAgreement equals true
  definition sellerProtectionDoesNotApply equals true
  definition liabilitySurvivesTermination equals true

# --- Section 6: Changes and Termination ---

scope APMChangesAndTermination =
  input disagreesWithChange : Boolean
  output payPalMayAddRemoveAPMsAnyTime : Boolean
  output amendmentsFollowUserAgreementChangeProcess : Boolean
  output merchantMayTerminateIfDisagrees : Boolean
  output merchantTerminatesByRemovingIntegration : Boolean
  output terminationDoesNotCloseAccount : Boolean
  output userAgreementRemainsInEffect : Boolean
  output payPalMayTerminateForAnyReason : Boolean
  output payPalMustGiveReasonableNotice : Boolean
  output termsSurviveTermination : Boolean

  definition payPalMayAddRemoveAPMsAnyTime equals true
  definition amendmentsFollowUserAgreementChangeProcess equals true
  definition merchantMayTerminateIfDisagrees equals disagreesWithChange
  definition merchantTerminatesByRemovingIntegration equals true
  definition terminationDoesNotCloseAccount equals true
  definition userAgreementRemainsInEffect equals true
  definition payPalMayTerminateForAnyReason equals true
  definition payPalMustGiveReasonableNotice equals true
  definition termsSurviveTermination equals true

# ============================================================
# Annex 1: APM Details
# Each APM scope encodes: paymentType, chargebackRisk,
