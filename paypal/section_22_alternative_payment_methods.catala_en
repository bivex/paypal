  output getRichQuickPyramidSchemes : Boolean
  output humanOrAnimalBodiesOrgans : Boolean
  output intellectualPropertyInfringement : Boolean
  output naziBrandedProducts : Boolean
  output noValueAddedWebsites : Boolean
  output payToRemoveDefamatory : Boolean
  output racistSexistAbusiveContent : Boolean
  output hazardousMaterials : Boolean

  definition illegalProductsAndServices equals true
  definition violenceAgainstGroups equals true
  definition counterfeitUnauthorizedGoods equals true
  definition drugsAndNarcotics equals true
  definition getRichQuickPyramidSchemes equals true
  definition humanOrAnimalBodiesOrgans equals true
