# PayPal Alternative Payment Methods Agreement
# Last updated: February 9, 2026
# Source: https://www.paypal.com/us/webapps/mpp/ua/apm-full
# Forms part of the PayPal User Agreement

# --- Section 1: About These Terms ---

scope APMAboutTerms =
  output appliesToAPMFunctionality : Boolean
  output apmFunctionalityDefinition : Boolean
  output apmIsPaymentMethodInAnnex1 : Boolean
  output payerDoesNotNeedAccount : Boolean
  output userAgreementFormsPart : Boolean
  output theseTermsOverrideOnConflict : Boolean
  output apmIncludedInServicesDefinition : Boolean

  definition appliesToAPMFunctionality equals true
  definition apmFunctionalityDefinition equals true
  definition apmIsPaymentMethodInAnnex1 equals true
  definition payerDoesNotNeedAccount equals true
  definition userAgreementFormsPart equals true
  definition theseTermsOverrideOnConflict equals true
  definition apmIncludedInServicesDefinition equals true

# --- Section 2: APM Prohibited Activities ---

scope APMProhibitedActivitiesGeneral =
  output mayNotAcceptForGoodsNotOnOwnAccount : Boolean
  output mayNotAcceptOutsideNormalBusinessScope : Boolean
  output mayNotAcceptProhibitedByTheseTerms : Boolean

  definition mayNotAcceptForGoodsNotOnOwnAccount equals true
  definition mayNotAcceptOutsideNormalBusinessScope equals true
  definition mayNotAcceptProhibitedByTheseTerms equals true

scope APMProhibitedCategoriesIllegal =
  output illegalProductsAndServices : Boolean
