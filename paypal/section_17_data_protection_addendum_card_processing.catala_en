scope DPACardAttachmentTransferPurposes =
  output purposeServicePerformance : Boolean
  output purposeFraudIdentification : Boolean
  output purposeLegalCompliance : Boolean
  output purposeAsSetForthInAddendum : Boolean

  definition purposeServicePerformance equals true
  definition purposeFraudIdentification equals true
  definition purposeLegalCompliance equals true
  definition purposeAsSetForthInAddendum equals true

