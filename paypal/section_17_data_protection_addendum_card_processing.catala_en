# PayPal Data Protection Addendum for Card Processing Products
# Last updated: December 1, 2021
# Source: PayPal Card Processing Products
# Forms part of the PayPal User Agreement

# --- Addendum Application ---

scope DPACardAddendumApplication =
  input serviceType : DPACardServiceType
  output appliesToPaymentServices : Boolean
  output doesNotApplyToWalletServices : Boolean
  output formsPartOfAgreement : Boolean
  output controlsOnConflict : Boolean

  definition appliesToPaymentServices equals
    serviceType equals -- CardProcessing or
    serviceType equals -- Gateway or
    serviceType equals -- FraudProtection

  definition doesNotApplyToWalletServices equals true
  definition formsPartOfAgreement equals true
  definition controlsOnConflict equals true

# --- Addendum Effective Date ---

scope DPACardEffectiveDate =
  input agreementEffectiveDate : Boolean
  input noticeEffectiveDate : Boolean
  output effectiveDateIsLaterOf : Boolean

  definition effectiveDateIsLaterOf equals
    agreementEffectiveDate or noticeEffectiveDate

# --- Addendum Amendments ---

scope DPACardAmendments =
  input reducesRightsOrIncreasesResponsibilities : Boolean
  output revisedVersionEffectiveWhenPosted : Boolean
  output substantialChangePostedOnPolicyUpdates : Boolean
  output mayDiscontinueIfDisagree : Boolean

  definition revisedVersionEffectiveWhenPosted equals true
  definition substantialChangePostedOnPolicyUpdates equals
    reducesRightsOrIncreasesResponsibilities
  definition mayDiscontinueIfDisagree equals true

# --- PayPal As Controller ---

scope DPACardPayPalAsController =
  output complyWithDataProtectionLaws : Boolean
  output implementAndMaintainSecurityMeasures : Boolean
  output notCauseMerchantBreach : Boolean
  output transferToThirdPartiesWithWrittenAgreements : Boolean
  output thirdPartyAgreementsNoLessProtective : Boolean

  definition complyWithDataProtectionLaws equals true
  definition implementAndMaintainSecurityMeasures equals true
  definition notCauseMerchantBreach equals true
  definition transferToThirdPartiesWithWrittenAgreements equals true
  definition thirdPartyAgreementsNoLessProtective equals true

# --- Independent Controllers ---

scope DPACardIndependentControllers =
  output merchantIsIndependentController : Boolean
  output payPalIsIndependentController : Boolean
  output notJointControllers : Boolean
  output payPalIndependentlyDeterminesPurposeAndMeans : Boolean

  definition merchantIsIndependentController equals true
  definition payPalIsIndependentController equals true
  definition notJointControllers equals true
  definition payPalIndependentlyDeterminesPurposeAndMeans equals true

# --- Permitted Processing Purposes ---

scope DPACardPermittedProcessing =
  output purposeProvideAndImproveServices : Boolean
  output purposeFraudPreventionAndDetection : Boolean
  output purposeLegalRegulatoryCompliance : Boolean
  output purposeProductAnalysisAndDevelopment : Boolean
  output purposeInternalUsageAnalytics : Boolean
  output purposeAggregateDisclosure : Boolean
  output purposeLawEnforcementAssistance : Boolean
  output purposeOtherAsNotified : Boolean

  definition purposeProvideAndImproveServices equals true
  definition purposeFraudPreventionAndDetection equals true
  definition purposeLegalRegulatoryCompliance equals true
  definition purposeProductAnalysisAndDevelopment equals true
  definition purposeInternalUsageAnalytics equals true
  definition purposeAggregateDisclosure equals true
  definition purposeLawEnforcementAssistance equals true
  definition purposeOtherAsNotified equals true

# --- Merchant Notice to Customers ---

scope DPACardMerchantNotice =
  output mustNotifyCustomersPayPalIsController : Boolean
  output mustIncludeLinkToPayPalPrivacyStatement : Boolean
  output commerciallyReasonableEffortsRequired : Boolean

  definition mustNotifyCustomersPayPalIsController equals true
  definition mustIncludeLinkToPayPalPrivacyStatement equals true
  definition commerciallyReasonableEffortsRequired equals true

# --- Mutual Assistance ---

scope DPACardMutualAssistance =
  output partiesShallCooperate : Boolean
  output merchantRespondsToSubjectAccessRequests : Boolean
  output merchantInformsCustomerOfPayPalRights : Boolean

  definition partiesShallCooperate equals true
  definition merchantRespondsToSubjectAccessRequests equals true
  definition merchantInformsCustomerOfPayPalRights equals true

# --- Security Incident Notification ---

scope DPACardSecurityIncidentNotification =
  input payPalMustNotifyCustomers : Boolean
  input payPalLacksContactInfo : Boolean
  output merchantShallProvideContactInfo : Boolean
  output commerciallyReasonableEffortsRequired : Boolean

  definition merchantShallProvideContactInfo equals
    payPalMustNotifyCustomers and payPalLacksContactInfo
  definition commerciallyReasonableEffortsRequired equals true

# --- Cross Border Data Transfers ---

scope DPACardCrossBorderTransfers =
  input transferOutsideCountryNecessary : Boolean
  input noAdequacyDecision : Boolean
  output payPalMayTransfer : Boolean
  output mustEnsureAppropriateSafeguards : Boolean
  output reliesOnBindingCorporateRules : Boolean

  definition payPalMayTransfer equals transferOutsideCountryNecessary
  definition mustEnsureAppropriateSafeguards equals noAdequacyDecision
  definition reliesOnBindingCorporateRules equals true

# --- EU Transfer Clauses Acceptance ---

scope DPACardEUTransferClausesAcceptance =
  input customerInEU : Boolean
  input customerInSwitzerland : Boolean
  input customerInEEA : Boolean
  input customerInUK : Boolean
  output agreementSignatureDeemedAcceptance : Boolean
  output merchantIsDataExporter : Boolean
  output payPalIsDataImporter : Boolean
  output module1ControllerToControllerApplies : Boolean

  definition agreementSignatureDeemedAcceptance equals
    customerInEU or customerInSwitzerland or customerInEEA or customerInUK

  definition merchantIsDataExporter equals agreementSignatureDeemedAcceptance
  definition payPalIsDataImporter equals agreementSignatureDeemedAcceptance
  definition module1ControllerToControllerApplies equals
    agreementSignatureDeemedAcceptance

# --- EU Transfer Clauses Specifics ---

scope DPACardEUTransferClausesDetails =
  output clause17Option1Applies : Boolean
  output governingLawLuxembourg : Boolean
  output jurisdictionLuxembourg : Boolean
  output appendixPerAttachment1 : Boolean

  definition clause17Option1Applies equals true
  definition governingLawLuxembourg equals true
  definition jurisdictionLuxembourg equals true
  definition appendixPerAttachment1 equals true

# --- UK Transfer Clauses Specifics ---

scope DPACardUKTransferClausesDetails =
  output clauseIIhiiiIncorporated : Boolean
  output payPalSignatureDeemedInitials : Boolean
  output annexBPerAttachment1 : Boolean

  definition clauseIIhiiiIncorporated equals true
  definition payPalSignatureDeemedInitials equals true
  definition annexBPerAttachment1 equals true

# --- Transfer Clauses Update Mechanism ---

scope DPACardTransferClausesUpdate =
  output newClausesSupersedeOld : Boolean
  output partiesAgreeToExecuteNewClauses : Boolean

  definition newClausesSupersedeOld equals true
  definition partiesAgreeToExecuteNewClauses equals true

