# --- Attachment 1: Sensitive Data ---

scope DPACardAttachmentSensitiveData =
  input merchantConfiguredSensitiveData : Boolean
  output sensitiveDataApplicable : Boolean
  output restrictionsAndSafeguardsApply : Boolean

  definition sensitiveDataApplicable equals merchantConfiguredSensitiveData
  definition restrictionsAndSafeguardsApply equals merchantConfiguredSensitiveData

# --- Attachment 1: Nature of Processing ---

scope DPACardAttachmentNatureOfProcessing =
  output asSetForthInAgreement : Boolean

  definition asSetForthInAgreement equals true

