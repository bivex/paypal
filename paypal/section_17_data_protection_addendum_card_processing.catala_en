  output retainedOnlyAsLongAsNecessary : Boolean
  output considersAmountNatureSensitivity : Boolean
  output considersRiskOfHarm : Boolean
  output considersPurposesAndAlternatives : Boolean
  output considersLegalRequirements : Boolean

  definition retainedOnlyAsLongAsNecessary equals true
