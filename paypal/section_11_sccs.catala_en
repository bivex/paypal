scope SCCITGovernanceCertification =
  output cisoOverseesInfoSecurity : Boolean
  output enterpriseRiskAndComplianceProgram : Boolean
  output iso27001Certification : Boolean
  output pciApplicableStandards : Boolean
  output aicpaSoc1AndSoc2 : Boolean
  output riskControlIdentificationProcess : Boolean
  output privacyImpactAssessments : Boolean
  output thirdPartyManagementProgram : Boolean

  definition cisoOverseesInfoSecurity equals true
  definition enterpriseRiskAndComplianceProgram equals true
  definition iso27001Certification equals true
  definition pciApplicableStandards equals true
  definition aicpaSoc1AndSoc2 equals true
  definition riskControlIdentificationProcess equals true
  definition privacyImpactAssessments equals true
  definition thirdPartyManagementProgram equals true

# --- Technical Measure: Data Minimization ---

scope SCCDataMinimization =
  output collectAdequateRelevantData : Boolean
  output limitedToNecessaryPurposes : Boolean
  output privacyImpactAssessmentCompliance : Boolean

  definition collectAdequateRelevantData equals true
  definition limitedToNecessaryPurposes equals true
  definition privacyImpactAssessmentCompliance equals true

# --- Technical Measure: Data Quality and Retention ---

scope SCCDataQualityRetention =
  output dataCorrectCompleteUpToDate : Boolean
  output usersCanCorrectParticulars : Boolean
  output dataGovernanceMonitoring : Boolean
  output dataClassifiedWithRetentionPeriods : Boolean
  output disposedAfterRetentionExpires : Boolean

  definition dataCorrectCompleteUpToDate equals true
  definition usersCanCorrectParticulars equals true
  definition dataGovernanceMonitoring equals true
  definition dataClassifiedWithRetentionPeriods equals true
  definition disposedAfterRetentionExpires equals true

# --- Technical Measure: Accountability ---

scope SCCAccountability =
  output infoSecurityAndPrivacyPoliciesAligned : Boolean
  output privacyProgramPolicyInPlace : Boolean
  output enterpriseRiskComplianceGovernance : Boolean
  output businessFunctionAccountability : Boolean
  output globalPrivacyDepartment : Boolean
  output enterpriseCommunicationsOnPrivacy : Boolean
  output riskManagementFramework : Boolean
  output reportingToManagementCommittees : Boolean

  definition infoSecurityAndPrivacyPoliciesAligned equals true
  definition privacyProgramPolicyInPlace equals true
  definition enterpriseRiskComplianceGovernance equals true
  definition businessFunctionAccountability equals true
  definition globalPrivacyDepartment equals true
  definition enterpriseCommunicationsOnPrivacy equals true
  definition riskManagementFramework equals true
  definition reportingToManagementCommittees equals true

# --- Technical Measure: Data Subject Rights ---

scope SCCDataSubjectRights =
  output accessRightFulfilled : Boolean
  output correctionRightFulfilled : Boolean
  output erasureRightFulfilled : Boolean
  input hasLegalObligationToRetain : Boolean
  output erasureMayBeWithheld : Boolean

  definition accessRightFulfilled equals true
  definition correctionRightFulfilled equals true
  definition erasureRightFulfilled equals true
  definition erasureMayBeWithheld equals hasLegalObligationToRetain

# --- Technical Measure: Processor Management ---

scope SCCProcessorManagement =
  output comprehensiveThirdPartyProgram : Boolean
  output contractualControlsInPlace : Boolean
  output subprocessorsRequireAdvanceApproval : Boolean
  output continuousRiskManagement : Boolean

  definition comprehensiveThirdPartyProgram equals true
  definition contractualControlsInPlace equals true
  definition subprocessorsRequireAdvanceApproval equals true
  definition continuousRiskManagement equals true
