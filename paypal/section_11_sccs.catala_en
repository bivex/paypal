scope SCCEventsLoggingConfiguration =
  output eventLoggingDefined : Boolean
  output centralizedSecurityMonitoring : Boolean
  output configurationManagementControl : Boolean
  output systemHardeningBaselines : Boolean

  definition eventLoggingDefined equals true
  definition centralizedSecurityMonitoring equals true
  definition configurationManagementControl equals true
  definition systemHardeningBaselines equals true

