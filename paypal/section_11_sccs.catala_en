scope SCCUserIdentificationAuthorization =
  output uniqueCorporateNetworkIdRequired : Boolean
  output automatedPasswordPolicies : Boolean
  output roleBasedAccessControl : Boolean
  output quarterlyAccessCertification : Boolean
  output leastPrivilegePrinciple : Boolean

  definition uniqueCorporateNetworkIdRequired equals true
  definition automatedPasswordPolicies equals true
  definition roleBasedAccessControl equals true
  definition quarterlyAccessCertification equals true
  definition leastPrivilegePrinciple equals true

# --- Technical Measure: Physical Security ---

scope SCCPhysicalSecurity =
  output globalSafetyAndSecurityPolicies : Boolean
  output specialEmphasisOnSensitiveAreas : Boolean
  output securitySystemsAndSafeguards : Boolean

  definition globalSafetyAndSecurityPolicies equals true
  definition specialEmphasisOnSensitiveAreas equals true
  definition securitySystemsAndSafeguards equals true

